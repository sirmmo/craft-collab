{"t":"meta","name":"gridcraft-1-offline","app":"gridcraft","schema":1,"format":1,"description":"Going offline and back: local and remote edits made meanwhile merge after the app's new sync1, including both sides growing the sheet past its last row at once (block ids `~<block>.<i>` make them land in the same rows)."}
{"t":"run","command":"collab.join","params":{"plugin":"org.craft.conformance","room":"conformance:offline","mode":"join","user":{"id":"u-app","name":"App Under Test","color":"#3B7DD8"},"role":"edit"}}
{"t":"out","msg":{"jsonrpc":"2.0","method":"collab/joined","params":{"room":"conformance:offline","clientId":"$clientId","user":{"id":"u-app","name":"App Under Test","color":"#3B7DD8"},"app":"gridcraft","schema":1,"encrypted":false}}}
{"t":"out","msg":{"jsonrpc":"2.0","method":"collab/sync1","params":{"room":"conformance:offline","stateVector":"$b64"}}}
{"t":"in","msg":{"jsonrpc":"2.0","method":"collab/status","params":{"room":"conformance:offline","state":"connecting","peers":[]}}}
{"t":"in","msg":{"jsonrpc":"2.0","method":"collab/status","params":{"room":"conformance:offline","state":"online","peers":[{"clientId":1001,"user":{"id":"u-peer","name":"Peer","color":"#D8513B"}}]}}}
{"t":"note","text":"Every time the transport reports online after another state, the app sends sync1."}
{"t":"out","msg":{"jsonrpc":"2.0","method":"collab/sync1","params":{"room":"conformance:offline","stateVector":"$b64"}}}
{"t":"in","msg":{"jsonrpc":"2.0","method":"collab/sync2","params":{"room":"conformance:offline","update":"","from":1001}}}
{"t":"model","model":{"title":"Budget","sheets":[{"name":"Budget","cells":{"A1":"Item","A2":"Coffee","A3":"Tea","A4":"Total","B1":"Cost","B2":"3.5","B3":"2","B4":"=SUM(B2:B3)"}}]}}
{"t":"in","msg":{"jsonrpc":"2.0","method":"collab/status","params":{"room":"conformance:offline","state":"offline","peers":[],"message":"Connection lost"}}}
{"t":"note","text":"Editing goes on offline; the app may send the updates now (the transport may queue them) or not."}
{"t":"run","command":"cell.set","params":{"cell":"B2","input":"4"}}
{"t":"out","msg":{"jsonrpc":"2.0","method":"collab/update","params":{"room":"conformance:offline","update":"$b64"}},"decodesTo":{"title":"Budget","sheets":[{"name":"Budget","cells":{"A1":"Item","A2":"Coffee","A3":"Tea","A4":"Total","B1":"Cost","B2":"4","B3":"2","B4":"=SUM(B2:B3)"}}]},"optional":true}
{"t":"run","command":"cell.set","params":{"cell":"A70","input":"far below"}}
{"t":"out","msg":{"jsonrpc":"2.0","method":"collab/update","params":{"room":"conformance:offline","update":"$b64"}},"decodesTo":{"title":"Budget","sheets":[{"name":"Budget","cells":{"A1":"Item","A2":"Coffee","A3":"Tea","A4":"Total","A70":"far below","B1":"Cost","B2":"4","B3":"2","B4":"=SUM(B2:B3)"}}]},"optional":true}
{"t":"note","text":"The peer edited too while the app was away, also past the last row; its update arrives once the app is back."}
{"t":"in","msg":{"jsonrpc":"2.0","method":"collab/status","params":{"room":"conformance:offline","state":"online","peers":[{"clientId":1001,"user":{"id":"u-peer","name":"Peer","color":"#D8513B"}}]}}}
{"t":"out","msg":{"jsonrpc":"2.0","method":"collab/sync1","params":{"room":"conformance:offline","stateVector":"$b64"}}}
{"t":"in","msg":{"jsonrpc":"2.0","method":"collab/update","params":{"room":"conformance:offline","update":"","from":1001}}}
{"t":"model","model":{"title":"Budget","sheets":[{"name":"Budget","cells":{"A1":"Item","A2":"Coffee","A3":"Tea","A4":"Total","A5":"Biscuits","A70":"far below","B1":"Cost","B100":"further below","B2":"4","B3":"2","B4":"=SUM(B2:B3)"}}]}}
{"t":"note","text":"The peer asks with its state vector: the app's answer holds its offline edits."}
{"t":"in","msg":{"jsonrpc":"2.0","method":"collab/sync1","params":{"room":"conformance:offline","stateVector":"AekH3wE=","from":1001}}}
{"t":"out","msg":{"jsonrpc":"2.0","method":"collab/sync2","params":{"room":"conformance:offline","update":"$b64","to":1001}},"decodesTo":{"title":"Budget","sheets":[{"name":"Budget","cells":{"A1":"Item","A2":"Coffee","A3":"Tea","A4":"Total","A5":"Biscuits","A70":"far below","B1":"Cost","B100":"further below","B2":"4","B3":"2","B4":"=SUM(B2:B3)"}}]}}
